# ViewMagnet Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# REQUIRED - Application Environment
# ============================================================
# Options: development, staging, production
ENVIRONMENT=development

# Debug mode (set to false in production)
DEBUG=false

# ============================================================
# REQUIRED - Database Configuration (Supabase)
# ============================================================
# Get this from Supabase dashboard → Project Settings → Database → Connection string
# Use the "Session mode" (port 5432) URL for Alembic migrations.
# Use the "Transaction mode" (port 6543) URL for the API if you need connection pooling.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ============================================================
# REQUIRED - JWT Authentication
# ============================================================
# Secret key for signing JWT tokens (min 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# Token expiration settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# REQUIRED - YouTube API Keys
# ============================================================
# At least one YouTube API key is required
# Get keys from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY_1=your-youtube-api-key-here

# Additional keys for quota distribution (optional)
# YOUTUBE_API_KEY_2=
# YOUTUBE_API_KEY_3=
# YOUTUBE_API_KEY_4=

# ============================================================
# OPTIONAL - YouTube OAuth (for Analytics)
# ============================================================
# Path to OAuth client secrets JSON file
# GOOGLE_CLIENT_SECRETS=secrets/youtube_oauth.json

# ============================================================
# OPTIONAL - AI Services
# ============================================================
# Anthropic Claude API key (for title generation, script writing)
# ANTHROPIC_API_KEY=your-anthropic-key

# Groq API key (free fallback LLM — get one at https://console.groq.com)
# GROQ_API_KEY=your-groq-key

# Synthetic (https://synthetic.new) — subscription access to OSS LLMs
# (Llama 3.3 70B, Qwen3 Coder, GLM, Kimi, DeepSeek). Used as a fallback
# between Anthropic and Groq. The base URL is OpenAI-compatible.
# SYNTHETIC_API_KEY=syn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SYNTHETIC_MODEL=hf:Qwen/Qwen3-Coder-480B-A35B-Instruct  # 256k ctx, MoE, clean JSON
# Avoid hf:moonshotai/Kimi-K2.5 and Kimi-K2.6 — they're reasoning models that
# burn the full max_tokens budget on hidden chain-of-thought, returning empty
# content for our prompts. Same for GLM-4.7 (reasoning leaks into reasoning_content).
# SYNTHETIC_BASE_URL=https://api.synthetic.new/openai/v1

# ElevenLabs API key (for voiceover generation)
# ELEVENLABS_API_KEY=your-elevenlabs-key

# Replicate API token (for AI thumbnail backgrounds)
# REPLICATE_API_TOKEN=your-replicate-token

# ============================================================
# OPTIONAL - Cloudflare R2 Storage
# ============================================================
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=viewmagnet-videos

# ============================================================
# OPTIONAL - CORS Configuration
# ============================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# OPTIONAL - Billing (Stripe subscriptions)
# ============================================================
# Without these, the billing endpoints return 503 ("billing not configured")
# and the Pricing CTAs degrade gracefully. Get keys from the Stripe dashboard.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Signing secret for the /billing/webhook endpoint (Stripe Dashboard → Webhooks)
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring Price IDs for each paid plan (Stripe Dashboard → Products)
# STRIPE_PRICE_STARTER=price_xxx   # $9/mo
# STRIPE_PRICE_PRO=price_xxx       # $29/mo
# STRIPE_PRICE_AGENCY=price_xxx    # $99/mo
# Where Stripe redirects after checkout/portal (defaults derive from FRONTEND_URL)
# STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/settings?tab=billing&checkout=success
# STRIPE_CANCEL_URL=http://localhost:3000/dashboard/settings?tab=billing&checkout=cancelled

# ============================================================
# OPTIONAL - Transactional Email (verification + password reset)
# ============================================================
# Provider for outbound email. Options: console (default — logs to stdout,
# no creds needed), smtp, resend. Auth emails fail-open: a misconfigured
# mailer never breaks signup/reset.
# EMAIL_PROVIDER=smtp
# From address shown to recipients.
# EMAIL_FROM=noreply@viewmagnet.io
# --- SMTP backend (EMAIL_PROVIDER=smtp) ---
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# --- Resend backend (EMAIL_PROVIDER=resend) ---
# RESEND_API_KEY=re_xxx

# ============================================================
# OPTIONAL - Monitoring
# ============================================================
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================================
# OPTIONAL - Rate Limiting
# ============================================================
# Maximum requests per period
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ============================================================
# OPTIONAL - Frontend Configuration
# ============================================================
# Frontend URL for redirects
FRONTEND_URL=http://localhost:3000

# ============================================================
# OPTIONAL - Social Media Publishing
# ============================================================
# Upload-Post API (recommended - unified API for all platforms)
# Get API key from: https://upload-post.com
# UPLOAD_POST_API_KEY=your-upload-post-api-key

# OR use direct platform APIs:

# TikTok Content Posting API
# Requires TikTok for Developers app with video.publish scope
# TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# Instagram Graph API (requires Business/Creator account)
# INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
# INSTAGRAM_USER_ID=your-instagram-user-id

# YouTube Upload (uses same OAuth as Analytics)
# YOUTUBE_OAUTH_CREDENTIALS=secrets/youtube_token.pickle

# ============================================================
# Realtime + infra
# ============================================================
# Redis powers live render-progress over WebSocket (/ws/renders), caching,
# and rate limiting. Without it, the frontend falls back to 2s polling.
# On Railway: add a Redis plugin and reference it, e.g. ${{Redis.REDIS_URL}}
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# Studio YouTube source playback (yt-dlp)
# ============================================================
# YouTube blocks automated downloads from datacenter IPs (Railway, etc.) with
# a "Sign in to confirm you're not a bot" / 403. To let the Studio preview and
# clip extraction resolve YouTube sources server-side, provide ONE of:
#
# 1) Cookies from a logged-in YouTube session (most reliable). Either a path
#    to a Netscape-format cookies.txt, or paste the file contents directly
#    (handy on PaaS where you can't mount files):
# YTDLP_COOKIES_FILE=/secrets/youtube_cookies.txt
# YTDLP_COOKIES=
#
# 2) A residential / rotating proxy that yt-dlp routes the fetch through:
# YTDLP_PROXY=http://user:pass@host:port
#
# Optional: override which yt-dlp player clients to try (default android,web)
# YTDLP_PLAYER_CLIENT=android,web
